<div class="relative isolate overflow-hidden bg-gray-900 text-white px-6 py-12 sm:py-16 lg:overflow-visible lg:px-0">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg class="absolute left-[50%] top-0 h-[64rem] w-[128rem] -translate-x-1/2 stroke-gray-800 opacity-50" aria-hidden="true">
      <defs>
        <pattern id="bgPattern" width="200" height="200" patternUnits="userSpaceOnUse">
          <path d="M100 200V.5M.5 .5H200" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" stroke-width="0" fill="url(#bgPattern)" />
    </svg>
  </div>

  <div class="mx-auto max-w-4xl">
    <div class="bg-gray-800 rounded-lg shadow-xl border border-gray-700 overflow-hidden pt-6">

      <div class="px-6 py-5 border-b border-gray-700 text-center">
        <h3 class="text-xl font-semibold text-gray-200">トレーニング内容</h3>
      </div>

      <div class="p-6">
        <div class="border border-gray-600 p-4 rounded bg-gray-700 text-gray-200 shadow-sm">
          <% if @workout.description.present? %>
            <div class="leading-relaxed space-y-2">
              <% @workout.description.split("\n").each do |line| %>
                <p><%= line.strip %></p>
              <% end %>
            </div>
          <% else %>
            <p>説明なし</p>
          <% end %>
        </div>

          <div class="md:col-span-2 p-3 bg-gray-800 text-gray-300 rounded border border-gray-600 shadow-sm">
            <p class="text-lg"><strong>✅ 完了状態:</strong> 
              <span class="<%= @workout.completed ? 'text-green-400 font-bold' : 'text-red-400 font-bold' %>">
                <%= @workout.completed ? "✔ 完了" : "✖ 未完了" %>
              </span>
            </p>
          </div>
        </div>
      </div>
      
      <div class="bg-gray-700 px-6 py-4 border-t border-gray-600 flex justify-center">
        <%= link_to "◀ メニューに戻る", workouts_path, class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>

    </div>
  </div>
</div>
