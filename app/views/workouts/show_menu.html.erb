<div class="relative fade-in isolate overflow-hidden bg-gray-900 min-h-screen flex items-center justify-center">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 mt-20">
    <!-- タイトルと説明を中央配置 -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">カスタマイズされたトレーニングメニュー</h2>
      <p class="mt-6 text-lg leading-8 text-gray-300">以下のメニューでトレーニングを開始しましょう。</p>
    </div>

    <div class="mt-6 text-lg text-white text-center">
      <p id="remaining-count">あと 3 回使えます</p>
    </div>

    <div class="mx-auto max-w-4xl mt-12 p-6 bg-gray-800 rounded-lg shadow-xl border border-gray-700">
      <!-- トレーニング内容 -->
      <div class="border-b border-gray-700 pb-4">
        <h3 class="text-xl font-semibold text-white">トレーニング内容</h3>
      </div>

      <% if @workout.present? && @workout.description.present? %>
        <div class="mt-6 p-4 bg-gray-700 text-white rounded shadow-sm">
          <p class="whitespace-pre-line break-words"><%= simple_format(@workout.description) %></p>
        </div>
      <% else %>
        <div class="mt-6 p-6 bg-gray-700 text-white rounded shadow-sm text-center">
          <h3 class="text-2xl font-semibold">メニューを生成できませんでした</h3>
          <p class="mt-2">もう一度試してください。</p>
        </div>
      <% end %>

      <!-- 戻るボタン -->
      <div class="bg-gray-700 px-6 py-4 border-t border-gray-600 flex justify-center mt-6">
        <%= link_to "カレンダーに戻る", calendars_path, class: "inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>
  </div>
</div>
