<div id="workoutModal" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="workoutTitle"></h5> <!-- ✅ これを `workoutTitle` に統一 -->
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p><strong>説明:</strong> <span id="workoutDescription"></span></p>
        <p><strong>日付:</strong> <span id="workoutDate"></span></p>
        <p><strong>時間:</strong> <span id="workoutTime"></span></p>
        <p><strong>完了状態:</strong> <span id="workoutCompleted"></span></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
      </div>
    </div>
  </div>
</div>
